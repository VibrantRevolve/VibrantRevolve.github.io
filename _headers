# Security and cache headers. Used automatically by Cloudflare Pages and Netlify.
# GitHub Pages ignores this file; see SETUP.md for the Cloudflare rule that does the same job.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(self)
